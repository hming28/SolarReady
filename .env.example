# SolarReady Malaysia Environment Variables
# Note: No paid APIs or secrets are required for standard local operation.

# Backend Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Path (relative to backend or absolute)
STORAGE_DIR=../data/storage
SAMPLE_ROOFS_DIR=../data/sample_roofs

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional AI Rooftop Segmentation (Roboflow Universe)
# Model: https://universe.roboflow.com/meds-workspace-u9euo/rooftop-segmentation-y0ovu
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=rooftop-segmentation-y0ovu/1

# Cloudflare R2 Cloud Storage (Optional - provides permanent cloud persistence on server restarts)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=solarready
R2_ENDPOINT_URL=
